# ─── Desenvolvimento local (PostgreSQL via Homebrew) ─────────────────────────
# Substitua <user> pelo seu usuário do sistema (ex: gabrielramos).
# O banco deve ser criado previamente com: createdb asof_intranet
DATABASE_URL=postgres://<user>@localhost:5432/asof_intranet
DATABASE_MIGRATION_URL=postgres://<user>@localhost:5432/asof_intranet

# ─── Supabase (produção / remoto) ─────────────────────────────────────────────
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_POSTGRES_URL=postgres://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_DATABASE_SUPABASE_URL=https://<project-ref>.supabase.co
# DATABASE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# NEXT_PUBLIC_DATABASE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# DATABASE_SUPABASE_ANON_KEY=<anon-key>
# NEXT_PUBLIC_DATABASE_SUPABASE_ANON_KEY=<anon-key>

# URL direta/non-pooling para migrations do Drizzle (obrigatória em produção)
# DATABASE_MIGRATION_URL=postgres://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Backend apenas. Nunca exponha no cliente/browser.
# DATABASE_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Seed do admin inicial ──────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=ChangeMe-2026!

# ─── Bypass de autenticação (desenvolvimento apenas) ───────────────────────────
SKIP_AUTH=true
DEV_USER_ID=1
DEV_USER_NAME="ASOF Dev User"
DEV_USER_EMAIL=dev@asof.local
DEV_USER_ROLE=admin
DEV_USER_MUST_CHANGE_PASSWORD=false

# ─── Proxy de confiança para extração de IP ────────────────────────────────────
# Number of trusted reverse-proxy hops (e.g. 1 for Vercel, 2 for Cloudflare→Vercel).
# Used by rate limiting to extract the real client IP from x-forwarded-for.
# TRUSTED_PROXY_COUNT=1
