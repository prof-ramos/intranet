# ─── Desenvolvimento local (PostgreSQL via Homebrew) ─────────────────────────
# Substitua <user> pelo seu usuário do sistema (ex: gabrielramos).
# O banco deve ser criado previamente com: createdb asof_intranet
DATABASE_URL=postgres://<user>@localhost:5432/asof_intranet
DATABASE_MIGRATION_URL=postgres://<user>@localhost:5432/asof_intranet

# ─── PostgreSQL gerenciado (produção / remoto) ────────────────────────────────
# DATABASE_URL=postgres://<runtime-user>:<password>@<pooler-host>:5432/<database>?sslmode=require

# URL direta/non-pooling para migrations do Drizzle (obrigatória em produção)
# DATABASE_MIGRATION_URL=postgres://<migration-user>:<password>@<direct-host>:5432/<database>?sslmode=require

# Staging só pode migrar quando o host da URL bater exatamente com este valor.
# Configure em GitHub/Vercel como variável do ambiente staging, não como secret de produção.
# DATABASE_STAGING_HOST=<staging-direct-host>

# URLs alternativas reconhecidas por provedores. Não use em produção oficial;
# produção deve configurar DATABASE_URL + DATABASE_MIGRATION_URL explicitamente.
# DATABASE_POSTGRES_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
# POSTGRES_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
# POSTGRES_PRISMA_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
# POSTGRES_URL_NON_POOLING=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require

# URL direta/non-pooling injetada pela integração Neon Vercel (preview deployments).
# Não use como substituto permanente de DATABASE_MIGRATION_URL em produção.
# DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<direct-host>:5432/<database>?sslmode=require

# ─── Dev realista restrito (PII real) ────────────────────────────────────────
# Use apenas quando docs/environments.md permitir. Não é onboarding padrão.
# Prefira branch/snapshot Neon a dump local e nunca use endpoints de produção.
# DATABASE_URL=postgres://<user>:<password>@<vercel-dev-pooler-host>/<dbname>?sslmode=require
# DATABASE_MIGRATION_URL=postgres://<user>:<password>@<vercel-dev-direct-host>/<dbname>?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<vercel-dev-direct-host>/<dbname>?sslmode=require

# db:seed:dev só roda em localhost por padrão. Para popular branch remoto
# descartável com dados sintéticos, confirme explicitamente:
# ALLOW_REMOTE_DEV_SEED=SEED_SYNTHETIC_DATA

# ─── Pool e conexão PostgreSQL ────────────────────────────────────────────────
# DB_CONNECT_TIMEOUT_SECONDS=30
# DB_IDLE_TIMEOUT_SECONDS=1800
# DB_MAX_CONNECTIONS=10
# DB_POOL_MODE=transaction
# DB_SSL=require
# USE_PGBOUNCER=true

# Sessão server-side própria. Use valor aleatório forte, nunca commitado.
SESSION_SECRET=change-me-with-at-least-32-characters

# Cron secret para jobs agendados (obrigatório em produção)
# CRON_SECRET=change-me-with-at-least-32-characters

# URL publica usada em links da aplicação.
# ASOF_INTRANET_URL=https://intranet.asof.com.br

# Chave de criptografia para dados sensíveis (PII) e E2E tests
# ENCRYPTION_MASTER_KEY=change-me-with-at-least-32-characters

# Nível de log: debug, info, warn, error
# LOG_LEVEL=info

# Ativar bundle analyzer: true/false
# ANALYZE=false

# ─── Email transacional (Mailjet) ─────────────────────────────────────────────
# O envio automatico de reset so e habilitado quando as chaves existem e o
# remetente abaixo foi validado no Mailjet. Sem essa flag, a UI admin mostra o
# fallback operacional de link/senha para comunicacao por canal seguro.
# MAILJET_API_KEY=<mailjet-api-key>
# MAILJET_SECRET_KEY=<mailjet-secret-key>
# MAILJET_SENDER_EMAIL=<remetente-validado@asof.org.br>
# MAILJET_SENDER_NAME=ASOF Intranet
# MAILJET_SENDER_VALIDATED=false

# ─── Seed do admin inicial ──────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=ChangeMe-2026!

# ─── Integrações ────────────────────────────────────────────────────────────────
# Gemini AI
# GEMINI_API_KEY=<gemini-api-key>

# Assinafy (assinatura digital)
# ASSINAFY_API_KEY=<api-key>
# ASSINAFY_ACCOUNT_ID=<account-id>
# ASSINAFY_WEBHOOK_SECRET=<webhook-secret>
# ASSINAFY_BASE_URL=https://api.assinafy.com.br

# Webhook encryption
# ASOF_WEBHOOK_SECRET_ENCRYPTION_KEY=change-me-with-at-least-32-characters

# Gmail / Email triage
# GMAIL_CLIENT_ID=<client-id>
# GMAIL_CLIENT_SECRET=<client-secret>
# GMAIL_REFRESH_TOKEN=<refresh-token>
# GMAIL_MAX_EMAILS_PER_RUN=10
# GMAIL_WATCH_TOPIC=<pubsub-topic>
# GMAIL_USER=controller@asof.org.br

# Habilitar AI no frontend
# NEXT_PUBLIC_AI_ENABLED=false

# ─── Notificações em tempo real (Novu) ─────────────────────────────────────────
# Opcional. Inbox só renderiza quando NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER
# está configurado. Lidos direto do cliente via process.env (não validados por env.ts).
# NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=<novu-app-identifier>
# NEXT_PUBLIC_NOVU_BACKEND_URL=https://eu.api.novu.co
# NEXT_PUBLIC_NOVU_SOCKET_URL=wss://eu.ws.novu.co

# ─── URL pública do app (PDFs/ofícios) ─────────────────────────────────────────
# Usada em links absolutos de PDF e ofícios. Lido via process.env (não em env.ts).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Bypass de autenticação (desenvolvimento apenas) ───────────────────────────
SKIP_AUTH=true
DEV_USER_ID=1
DEV_USER_NAME="ASOF Dev User"
DEV_USER_EMAIL=dev@asof.local
DEV_USER_ROLE=admin
DEV_USER_MUST_CHANGE_PASSWORD=false

# ─── Proxy de confiança para extração de IP ────────────────────────────────────
# Number of trusted reverse-proxy hops (e.g. 1 for Vercel, 2 for Cloudflare→Vercel).
# Used by rate limiting to extract the real client IP from x-forwarded-for.
# TRUSTED_PROXY_COUNT=1

# ─── Ambiente de deploy ────────────────────────────────────────────────────────
# NODE_ENV=development
# VERCEL_ENV=production
