# ─── Obrigatório em produção ───────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite local: file:sqlite.db | Turso Cloud: libsql://<host>
DATABASE_URL=file:sqlite.db

# Obrigatório quando DATABASE_URL usa libsql://
DATABASE_AUTH_TOKEN=

# ─── Seed do admin inicial ──────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=gabriel@asof.org.br
INITIAL_ADMIN_PASSWORD=admin123

# ─── Bypass de autenticação (desenvolvimento apenas) ───────────────────────────
SKIP_AUTH=true
DEV_USER_ID=1
DEV_USER_NAME=ASOF Dev User
DEV_USER_EMAIL=dev@asof.local
DEV_USER_ROLE=admin
DEV_USER_MUST_CHANGE_PASSWORD=false
