{
  "name": "asof-intranet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "NODE_ENV=production next build --webpack",
    "build:turbo": "NODE_ENV=production next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:quick": "npm run typecheck && npm run lint && npm run test",
    "validate:full": "npm run validate:quick && npm run test:db && npm run build",
    "scope:check": "bash scripts/check-scope.sh --strict",
    "scope:status": "bash scripts/check-scope.sh",
    "pr:check": "bash scripts/check-pr-ready.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts src/lib/db/schema.integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:metrics": "tsx scripts/test-metrics/summary.ts",
    "test:metrics:clean": "rm -rf .test-metrics",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/guarded-migrate.ts",
    "db:migrate:unsafe": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-admin.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@novu/react": "^3.16.0",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "bcryptjs": "^3.0.3",
    "daisyui": "^5.5.20",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "esbuild": "0.28.0",
    "postcss": "8.5.14"
  }
}
